+    def _supo_postprocess_batch(self, batch: DataProto):
+        """SUPO patch. (1) rollouts flagged `overlong` (no final answer within H steps / S
+        summaries) get response_mask=0 so they contribute neither to the policy loss nor to its
+        token normalisation while still counting in the group mean/std; (2) pad the batch with
+        dummy rows (response_mask=0, fresh uid) to a multiple of the world size so DataProto can
+        be chunked across data-parallel ranks; (3) log rollout statistics."""
+        metrics = {}
+        nt = batch.non_tensor_batch
+        if "overlong" in nt:
+            overlong = torch.tensor(np.asarray(nt["overlong"], dtype=np.float32))
+            batch.batch["response_mask"] = batch.batch["response_mask"] * (1.0 - overlong).unsqueeze(-1).to(
+                batch.batch["response_mask"].dtype
+            )
+            metrics["supo/overlong_frac_rows"] = float(overlong.mean().item())
+        if "gen_uid" in nt:
+            gen_uids = nt["gen_uid"]
+            n_rollouts = len(set(gen_uids.tolist()))
+            metrics["supo/num_rollouts"] = float(n_rollouts)
+            metrics["supo/num_trajectory_rows"] = float(len(batch))
+            metrics["supo/trajs_per_rollout"] = float(len(batch) / max(n_rollouts, 1))
+            # rollout-level stats (de-duplicated by gen_uid)
+            seen = set()
+            per_rollout = {k: [] for k in ("overlong", "finished", "num_tool_calls", "num_summaries")}
+            for i, g in enumerate(gen_uids):
+                if g in seen:
+                    continue
+                seen.add(g)
+                for k in per_rollout:
+                    if k in nt:
+                        per_rollout[k].append(float(nt[k][i]))
+            for k, v in per_rollout.items():
+                if v:
+                    metrics[f"supo/{k}_mean"] = float(np.mean(v))
+        world_size = self.config.trainer.n_gpus_per_node * self.config.trainer.nnodes
+        pad = (-len(batch)) % world_size
+        metrics["supo/num_dummy_rows"] = float(pad)
+        if pad > 0:
+            dummy = batch.slice(0, pad)
+            dummy = DataProto(batch=dummy.batch.clone(), non_tensor_batch=dict(dummy.non_tensor_batch),
+                              meta_info=dummy.meta_info)
+            dummy.batch["response_mask"] = torch.zeros_like(dummy.batch["response_mask"])
+            if "rm_scores" in dummy.batch:
+                dummy.batch["rm_scores"] = torch.zeros_like(dummy.batch["rm_scores"])
+            dummy.non_tensor_batch["uid"] = np.array([f"dummy-{uuid.uuid4()}" for _ in range(pad)], dtype=object)
+            if "gen_uid" in dummy.non_tensor_batch:
+                dummy.non_tensor_batch["gen_uid"] = np.array([f"dummy-{uuid.uuid4()}" for _ in range(pad)], dtype=object)
+            if "overlong" in dummy.non_tensor_batch:
+                dummy.non_tensor_batch["overlong"] = np.array([True] * pad, dtype=object)
+            meta_info = batch.meta_info
+            batch = DataProto.concat([batch, dummy])
+            batch.meta_info = meta_info
+        return batch, metrics
+

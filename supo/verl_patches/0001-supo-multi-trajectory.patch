diff --git a/verl/trainer/ppo/core_algos.py b/verl/trainer/ppo/core_algos.py
index 9d08b84..75a22f2 100644
--- a/verl/trainer/ppo/core_algos.py
+++ b/verl/trainer/ppo/core_algos.py
@@ -331,6 +331,52 @@ def compute_grpo_outcome_advantage(
     return scores, scores
 
 
+@register_adv_est("supo")
+def compute_supo_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    index: np.ndarray,
+    gen_uid: Optional[np.ndarray] = None,
+    epsilon: float = 1e-6,
+    norm_adv_by_std_in_grpo: bool = True,
+    config: Optional[AlgoConfig] = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """SUPO advantage (arXiv 2510.06727, eq. 3): group-relative advantage computed over the
+    G rollouts of a prompt (one reward per rollout, trajectories of the same rollout are
+    de-duplicated via `gen_uid`), then broadcast to every token of every trajectory of that
+    rollout. With one trajectory per rollout this is exactly GRPO."""
+    response_length = token_level_rewards.shape[-1]
+    scores = token_level_rewards.sum(dim=-1)
+    if gen_uid is None:
+        gen_uid = np.arange(scores.shape[0])
+    id2score = defaultdict(list)
+    id2seen = defaultdict(set)
+    with torch.no_grad():
+        bsz = scores.shape[0]
+        for i in range(bsz):
+            if gen_uid[i] in id2seen[index[i]]:
+                continue
+            id2seen[index[i]].add(gen_uid[i])
+            id2score[index[i]].append(scores[i])
+        id2mean, id2std = {}, {}
+        for idx, lst in id2score.items():
+            if len(lst) == 1:
+                id2mean[idx] = torch.tensor(0.0)
+                id2std[idx] = torch.tensor(1.0)
+            else:
+                t = torch.stack(lst)
+                id2mean[idx] = torch.mean(t)
+                id2std[idx] = torch.std(t)
+        adv = torch.empty_like(scores)
+        for i in range(bsz):
+            if norm_adv_by_std_in_grpo:
+                adv[i] = (scores[i] - id2mean[index[i]]) / (id2std[index[i]] + epsilon)
+            else:
+                adv[i] = scores[i] - id2mean[index[i]]
+        adv = adv.unsqueeze(-1).tile([1, response_length]) * response_mask
+    return adv, adv
+
+
 @register_adv_est(AdvantageEstimator.GRPO_VECTORIZED)
 def compute_grpo_vectorized_outcome_advantage(
     token_level_rewards: torch.Tensor,
